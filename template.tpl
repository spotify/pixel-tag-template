scenarios:
- name: Loads the pixel and sends consent, conf and a page view
  code: |-
    runCode(mockData);

    assertThat(spotifyCalls).isEqualTo([
      ['consent', 'granted'],
      ['conf', {key: mockData.pixelId, integration: 'gtm', integration_version: '0.1.0'}],
      ['view']
    ]);
    assertApi('injectScript').wasCalled();
    assertApi('gtmOnSuccess').wasCalled();
- name: Fails on a malformed pixel ID
  code: |-
    mockData.pixelId = 'abc123';

    runCode(mockData);

    assertThat(spotifyCalls).isEqualTo([]);
    assertApi('injectScript').wasNotCalled();
    assertApi('gtmOnFailure').wasCalled();
- name: Fails on an event name that is not a Spotify event
  code: |-
    mockData.eventName = 'order_complete';

    runCode(mockData);

    assertApi('gtmOnFailure').wasCalled();
- name: Uses an existing snippet without loading or configuring again
  code: |-
    mock('copyFromWindow', (key) => key === 'spdt' ? function() {} : undefined);
    mock('callInWindow', function() {
      spotifyCalls.push([arguments[1], arguments[2]]);
    });
    mockData.eventName = 'lead';

    runCode(mockData);

    assertThat(spotifyCalls).isEqualTo([['lead', {}]]);
    assertApi('injectScript').wasNotCalled();
    assertApi('gtmOnSuccess').wasCalled();
- name: Holds events as pending when Consent Mode denies ad_storage
  code: |-
    mock('isConsentGranted', false);

    runCode(mockData);

    assertThat(spotifyCalls[0]).isEqualTo(['consent', 'pending']);
    assertApi('addConsentListener').wasCalled();
- name: Maps a GA4 purchase from the data layer
  code: |-
    mockData.eventSource = 'dataLayer';
    mock('copyFromDataLayer', (key) => ({
      event: 'purchase',
      ecommerce: {
        transaction_id: 'T-1',
        value: 30,
        currency: 'USD',
        items: [{item_id: 'SKU-1', item_name: 'Tee', price: 15, quantity: 2}]
      }
    })[key]);

    runCode(mockData);

    assertThat(spotifyCalls[2]).isEqualTo(['purchase', {
      value: 30,
      currency: 'USD',
      quantity: 2,
      order_id: 'T-1',
      line_items: [{value: 15, quantity: 2, product_id: 'SKU-1', product_name: 'Tee'}]
    }]);
- name: Drops pre-hashed email and sends raw phone number
  code: |-
    mockData.userDataSource = 'manual';
    mockData.userEmail = 'a665a45920422f9d417e4867efdc4fb8a04a1f3fff1fa07e998e86f7f7a27ae3';
    mockData.userPhoneNumber = '+14155552671';

    runCode(mockData);

    assertThat(spotifyCalls[2]).isEqualTo(['alias', {phone_number: '+14155552671'}]);
setup: |-
  const mockData = {
    pixelId: '0a1b2c3d4e5f60718293a4b5c6d7e8f9',
    eventSource: 'fixed',
    eventName: 'view',
    consentSource: 'googleConsentMode',
    isAutoViewEnabled: true,
    isEcommerceMappingEnabled: true,
    userDataSource: 'none'
  };

  const storedItems = {};
  mockObject('templateStorage', {
    getItem: (key) => storedItems[key],
    setItem: (key, value) => { storedItems[key] = value; },
    removeItem: (key) => { storedItems[key] = undefined; },
    clear: () => {}
  });

  let spotifyCalls = [];
  mock('copyFromWindow', undefined);
  mock('createArgumentsQueue', () => function() {
    if (arguments.length > 1) {
      spotifyCalls.push([arguments[0], arguments[1]]);
    } else {
      spotifyCalls.push([arguments[0]]);
    }
  });
  mock('injectScript', (url, onSuccess) => onSuccess());


