const addConsentListener = require('addConsentListener');
const callInWindow = require('callInWindow');
const copyFromDataLayer = require('copyFromDataLayer');
const copyFromWindow = require('copyFromWindow');
const createArgumentsQueue = require('createArgumentsQueue');
const getContainerVersion = require('getContainerVersion');
const getType = require('getType');
const getUrl = require('getUrl');
const injectScript = require('injectScript');
const isConsentGranted = require('isConsentGranted');
const JSON = require('JSON');
const logToConsole = require('logToConsole');
const makeInteger = require('makeInteger');
const makeNumber = require('makeNumber');
const makeString = require('makeString');
const makeTableMap = require('makeTableMap');
const Object = require('Object');
const templateStorage = require('templateStorage');

const TEMPLATE_VERSION = '0.1.0';
const SCRIPT_URL = 'https://pixel.byspotify.com/ping.min.js';
const SCRIPT_CACHE_TOKEN = 'spotifyPixel';
const QUEUE_NAME = 'spdt';
const LEGACY_QUEUE_NAME = 'pdst';
const CONSENT_TYPE = 'ad_storage';
const USER_DATA_CONSENT_TYPE = 'ad_user_data';
const LOG_PREFIX = '[Spotify Pixel] ';

// templateStorage is shared by every tag created from this template on the
// page, which is what keeps `conf`, consent and page views to once per page.
const STORAGE_KEYS = {
  configuredPixelId: 'configuredPixelId',
  isExistingInstall: 'isExistingInstall',
  isConsentListenerAdded: 'isConsentListenerAdded',
  lastConsentState: 'lastConsentState',
  configurationState: 'configurationState',
  lastAliasPayload: 'lastAliasPayload',
  lastViewUrl: 'lastViewUrl'
};

const SPOTIFY_EVENTS = [
  'view',
  'product',
  'addtocart',
  'checkout',
  'purchase',
  'lead',
  'signup',
  'custom_event_1',
  'custom_event_2',
  'custom_event_3',
  'custom_event_4',
  'custom_event_5'
];

const LINE_ITEM_EVENTS = [
  'checkout',
  'purchase',
  'custom_event_1',
  'custom_event_2',
  'custom_event_3',
  'custom_event_4',
  'custom_event_5'
];

const SINGLE_PRODUCT_EVENTS = [
  'product',
  'addtocart',
  'custom_event_1',
  'custom_event_2',
  'custom_event_3',
  'custom_event_4',
  'custom_event_5'
];

const DATA_LAYER_EVENT_MAP = {
  'gtm.js': 'view',
  page_view: 'view',
  view_item: 'product',
  add_to_cart: 'addtocart',
  begin_checkout: 'checkout',
  purchase: 'purchase',
  generate_lead: 'lead',
  sign_up: 'signup'
};

const CONSENT_STATES = ['granted', 'denied', 'pending'];

const containerVersion = getContainerVersion() || {};
const isDebug =
  data.isDebugLoggingEnabled === true ||
  containerVersion.debugMode === true ||
  containerVersion.previewMode === true;

/*==============================================================================
  Main
==============================================================================*/

const pixelId = trim(makeString(data.pixelId || ''));
if (!isPixelId(pixelId)) {
  return fail('Pixel ID must be the 32-character ID from Spotify Ads Manager, got "' + pixelId + '".');
}

const configuredPixelId = templateStorage.getItem(STORAGE_KEYS.configuredPixelId);
if (configuredPixelId && configuredPixelId !== pixelId) {
  return fail(
    'This page is already using pixel ' + configuredPixelId +
    '. The Spotify Pixel supports one pixel ID per page, so this tag (pixel ' + pixelId + ') was not sent.'
  );
}

const isFirstFire = !configuredPixelId;
if (isFirstFire) {
  const hasExistingInstall = !!(copyFromWindow(QUEUE_NAME) || copyFromWindow(LEGACY_QUEUE_NAME));
  templateStorage.setItem(STORAGE_KEYS.isExistingInstall, hasExistingInstall);
  templateStorage.setItem(STORAGE_KEYS.configuredPixelId, pixelId);
  if (hasExistingInstall) {
    log('Found a Spotify Pixel already installed on the page. Using it instead of loading a second copy.');
  }
}
const isExistingInstall = templateStorage.getItem(STORAGE_KEYS.isExistingInstall) === true;

const eventName = resolveEventName();
if (eventName === null) {
  return fail('"' + makeString(data.eventName) + '" is not a Spotify Pixel event. Use one of: ' + SPOTIFY_EVENTS.join(', ') + '.');
}

syncConsent();
if (!isExistingInstall && isFirstFire) {
  sendConfiguration();
}

const aliasPayload = buildAliasPayload();
if (aliasPayload) {
  send('alias', aliasPayload);
}

if (eventName === 'view') {
  sendPageView();
} else if (eventName) {
  send(eventName, buildEventParameters(eventName));
}

if (isExistingInstall) {
  data.gtmOnSuccess();
} else {
  injectScript(SCRIPT_URL, data.gtmOnSuccess, () => fail('Could not load ' + SCRIPT_URL + '.'), SCRIPT_CACHE_TOKEN);
}

/*==============================================================================
  Pixel commands
==============================================================================*/

function send(command, payload) {
  log('spdt(' + JSON.stringify(command) + (payload ? ', ' + JSON.stringify(payload) : '') + ')');
  if (copyFromWindow(QUEUE_NAME)) {
    if (payload) {
      callInWindow(QUEUE_NAME, command, payload);
    } else {
      callInWindow(QUEUE_NAME, command);
    }
    return;
  }
  const queue = createArgumentsQueue(QUEUE_NAME, QUEUE_NAME + '.q');
  if (payload) {
    queue(command, payload);
  } else {
    queue(command);
  }
}

// The SDK holds calls while consent is pending and drops them while it is
// denied, `conf` included, and it accepts `conf` only once it has run. Track
// where ours ended up so a later grant can send it again.
function sendConfiguration() {
  send('conf', buildConfiguration());
  const consentState = templateStorage.getItem(STORAGE_KEYS.lastConsentState);
  let configurationState = 'delivered';
  if (consentState === 'pending') configurationState = 'held';
  if (consentState === 'denied') configurationState = 'dropped';
  templateStorage.setItem(STORAGE_KEYS.configurationState, configurationState);
}

function updateConfigurationForConsent(state) {
  const configurationState = templateStorage.getItem(STORAGE_KEYS.configurationState);
  if (state === 'denied' && configurationState === 'held') {
    templateStorage.setItem(STORAGE_KEYS.configurationState, 'dropped');
    return;
  }
  if (state !== 'granted') return;
  if (configurationState === 'held') {
    templateStorage.setItem(STORAGE_KEYS.configurationState, 'delivered');
    return;
  }
  if (configurationState !== 'dropped') return;

  log('Consent was granted after the pixel configuration was dropped, so it was sent again.');
  sendConfiguration();
  // The page view and alias were dropped with it. The alias goes out again on
  // the next tag fire, and the view is resent for the current page.
  templateStorage.removeItem(STORAGE_KEYS.lastAliasPayload);
  if (templateStorage.getItem(STORAGE_KEYS.lastViewUrl)) {
    templateStorage.setItem(STORAGE_KEYS.lastViewUrl, getUrl());
    send('view');
  }
}

function buildConfiguration() {
  const configuration = {
    key: pixelId,
    integration: 'gtm',
    integration_version: TEMPLATE_VERSION
  };
  if (data.isAutoViewEnabled === false) {
    configuration.autoView = false;
  }
  if (hasValue(data.partner)) {
    configuration.partner = makeString(data.partner);
  }
  return configuration;
}

// With SPA auto-view on, the SDK reports every later navigation itself, so the
// template only sends the first view. With it off, the advertiser's own
// triggers drive views and the template only skips repeats of the same URL.
function sendPageView() {
  const lastViewUrl = templateStorage.getItem(STORAGE_KEYS.lastViewUrl);
  const currentUrl = getUrl();
  const isAutoViewEnabled = data.isAutoViewEnabled !== false && !isExistingInstall;
  if (lastViewUrl && (isAutoViewEnabled || lastViewUrl === currentUrl)) {
    log('Skipped a page view that was already sent for this page.');
    return;
  }
  templateStorage.setItem(STORAGE_KEYS.lastViewUrl, currentUrl);
  send('view');
}

/*==============================================================================
  Consent
==============================================================================*/

function isGoogleConsentMode() {
  return data.consentSource !== 'variable' && data.consentSource !== 'none';
}

function syncConsent() {
  if (data.consentSource === 'variable') {
    const state = normalizeConsentState(data.consentState);
    if (!state) {
      log('Consent variable resolved to "' + makeString(data.consentState) + '". Expected granted, denied or pending, so no consent signal was sent.');
      return;
    }
    sendConsent(state);
    return;
  }

  // A hand-installed snippet owns its own consent calls, and Consent Mode
  // reports "granted" on sites that never set it, which would override them.
  if (!isGoogleConsentMode() || isExistingInstall) {
    return;
  }

  // Google Consent Mode has no "undecided" state: before the visitor chooses,
  // ad_storage is simply denied. Treat that as pending so the SDK holds events
  // in memory, and only send denied when the visitor actively revokes.
  if (isConsentGranted(CONSENT_TYPE)) {
    sendConsent('granted');
  } else if (!templateStorage.getItem(STORAGE_KEYS.lastConsentState)) {
    sendConsent('pending');
  }

  if (!templateStorage.getItem(STORAGE_KEYS.isConsentListenerAdded)) {
    templateStorage.setItem(STORAGE_KEYS.isConsentListenerAdded, true);
    addConsentListener(CONSENT_TYPE, (consentType, isGranted) => {
      sendConsent(isGranted ? 'granted' : 'denied');
    });
  }
}

function sendConsent(state) {
  if (templateStorage.getItem(STORAGE_KEYS.lastConsentState) === state) {
    return;
  }
  templateStorage.setItem(STORAGE_KEYS.lastConsentState, state);
  send('consent', state);
  updateConfigurationForConsent(state);
}

function normalizeConsentState(value) {
  if (value === true || value === 'true') return 'granted';
  if (value === false || value === 'false') return 'denied';
  const state = trim(makeString(value || '')).toLowerCase();
  return CONSENT_STATES.indexOf(state) === -1 ? null : state;
}

/*==============================================================================
  Event name
==============================================================================*/

// Returns a Spotify event name, '' when this fire should only load the pixel,
// or null when a fixed event name is not a Spotify event.
function resolveEventName() {
  if (data.eventSource === 'dataLayer') {
    const dataLayerEvent = makeString(copyFromDataLayer('event') || '');
    const customMappings = makeTableMap(data.eventMappings || [], 'dataLayerEvent', 'spotifyEvent') || {};
    const mappedEvent = customMappings[dataLayerEvent] || DATA_LAYER_EVENT_MAP[dataLayerEvent];
    if (!mappedEvent) {
      log('Data layer event "' + dataLayerEvent + '" has no Spotify mapping, so only the pixel was loaded.');
      return '';
    }
    return isSpotifyEvent(mappedEvent) ? mappedEvent : null;
  }

  const eventName = trim(makeString(data.eventName || 'view')).toLowerCase();
  if (eventName === 'none') {
    return '';
  }
  return isSpotifyEvent(eventName) ? eventName : null;
}

function isSpotifyEvent(eventName) {
  return SPOTIFY_EVENTS.indexOf(eventName) !== -1;
}

/*==============================================================================
  Event parameters
==============================================================================*/

function buildEventParameters(eventName) {
  const parameters = {};

  if (data.isEcommerceMappingEnabled !== false) {
    assign(parameters, getDataLayerParameters(eventName));
  }

  if (getType(data.eventParametersVariable) === 'object') {
    assign(parameters, data.eventParametersVariable);
  }

  const tableParameters = makeTableMap(data.eventParameters || [], 'name', 'value');
  if (tableParameters) {
    assign(parameters, tableParameters);
  }

  if (hasValue(data.customEventName) && eventName.indexOf('custom_event_') === 0) {
    parameters.custom_event_name = makeString(data.customEventName);
  }

  if (hasValue(data.eventId)) {
    parameters.event_id = makeString(data.eventId);
  }

  return coerceParameterTypes(parameters);
}

function getDataLayerParameters(eventName) {
  const parameters = {};
  // Data layer version 1 returns the ecommerce object from the latest push that
  // set it, instead of a deep merge of every push, so an add_to_cart can't
  // inherit an earlier purchase's transaction_id.
  const ecommerceValue = copyFromDataLayer('ecommerce', 1);
  const ecommerce = getType(ecommerceValue) === 'object' ? ecommerceValue : {};
  const items = getType(ecommerce.items) === 'array' ? ecommerce.items : [];

  const value = firstValue([ecommerce.value, copyFromDataLayer('value'), sumItemValues(items)]);
  if (hasValue(value)) parameters.value = value;

  const currency = firstValue([ecommerce.currency, copyFromDataLayer('currency'), items.length ? items[0].currency : undefined]);
  if (hasValue(currency)) parameters.currency = currency;

  if (items.length) {
    parameters.quantity = sumItemQuantities(items);
  }

  if (hasValue(ecommerce.transaction_id)) parameters.order_id = ecommerce.transaction_id;
  if (hasValue(ecommerce.coupon)) parameters.discount_code = ecommerce.coupon;

  const isNewCustomer = firstValue([ecommerce.new_customer, copyFromDataLayer('new_customer')]);
  if (hasValue(isNewCustomer)) parameters.is_new_customer = isNewCustomer;

  if (eventName === 'signup') {
    const signUpMethod = copyFromDataLayer('method');
    if (hasValue(signUpMethod)) parameters.sign_up_method = signUpMethod;
  }

  if (LINE_ITEM_EVENTS.indexOf(eventName) !== -1 && items.length) {
    parameters.line_items = items.map((item) => mapItemToProduct(item, true));
  }

  // Spotify's product and addtocart events describe a single product, so a
  // multi-item push is not flattened onto them by guessing which item to keep.
  if (SINGLE_PRODUCT_EVENTS.indexOf(eventName) !== -1 && items.length === 1) {
    assign(parameters, mapItemToProduct(items[0], false));
  }

  return parameters;
}

function mapItemToProduct(item, isLineItem) {
  const product = {};
  if (getType(item) !== 'object') return product;
  if (isLineItem && hasValue(item.price)) product.value = item.price;
  if (isLineItem && hasValue(item.quantity)) product.quantity = item.quantity;
  if (hasValue(item.item_id)) product.product_id = item.item_id;
  if (hasValue(item.item_name)) product.product_name = item.item_name;
  if (hasValue(item.item_category)) product.product_type = item.item_category;
  if (hasValue(item.item_brand)) product.product_vendor = item.item_brand;
  if (hasValue(item.item_variant_id)) product.variant_id = item.item_variant_id;
  if (hasValue(item.item_variant)) product.variant_name = item.item_variant;
  return product;
}

function sumItemValues(items) {
  if (!items.length) return undefined;
  let total = 0;
  let hasPrice = false;
  items.forEach((item) => {
    if (getType(item) === 'object' && hasValue(item.price)) {
      hasPrice = true;
      total += makeNumber(item.price) * (hasValue(item.quantity) ? makeNumber(item.quantity) : 1);
    }
  });
  return hasPrice ? total : undefined;
}

function sumItemQuantities(items) {
  let total = 0;
  items.forEach((item) => {
    total += getType(item) === 'object' && hasValue(item.quantity) ? makeInteger(item.quantity) : 1;
  });
  return total;
}

function coerceParameterTypes(parameters) {
  if (hasValue(parameters.value)) parameters.value = makeNumber(parameters.value);
  if (hasValue(parameters.quantity)) parameters.quantity = makeInteger(parameters.quantity);
  if (hasValue(parameters.is_new_customer)) {
    parameters.is_new_customer = parameters.is_new_customer === true || parameters.is_new_customer === 'true';
  }
  ['currency', 'order_id', 'discount_code', 'product_id', 'product_name', 'product_type', 'product_vendor', 'variant_id', 'variant_name'].forEach((key) => {
    if (hasValue(parameters[key])) parameters[key] = makeString(parameters[key]);
  });
  if (getType(parameters.line_items) === 'array') {
    parameters.line_items = parameters.line_items.map((lineItem) => {
      if (getType(lineItem) !== 'object') return lineItem;
      if (hasValue(lineItem.value)) lineItem.value = makeNumber(lineItem.value);
      if (hasValue(lineItem.quantity)) lineItem.quantity = makeInteger(lineItem.quantity);
      ['product_id', 'product_name', 'product_type', 'product_vendor', 'variant_id', 'variant_name'].forEach((key) => {
        if (hasValue(lineItem[key])) lineItem[key] = makeString(lineItem[key]);
      });
      return lineItem;
    });
  }
  return parameters;
}

/*==============================================================================
  User data (alias)
==============================================================================*/

function buildAliasPayload() {
  const source = getUserDataSource();
  if (!source) return null;

  if (isGoogleConsentMode() && !isConsentGranted(USER_DATA_CONSENT_TYPE)) {
    log('Skipped user data because ' + USER_DATA_CONSENT_TYPE + ' is not granted.');
    return null;
  }

  const payload = {};
  addUserValue(payload, 'email', firstValue([source.email, source.email_address, source.sha256_email_address]));
  addUserValue(payload, 'phone_number', firstValue([source.phone_number, source.phone, source.sha256_phone_number]));
  if (hasValue(source.id)) payload.id = trim(makeString(source.id));
  if (hasValue(source.partner_user_id)) payload.partner_user_id = trim(makeString(source.partner_user_id));

  if (!Object.keys(payload).length) return null;

  // The SDK stores alias data and replays it on later pages, so resending the
  // same values on every tag fire adds nothing.
  const serializedPayload = JSON.stringify(payload);
  if (templateStorage.getItem(STORAGE_KEYS.lastAliasPayload) === serializedPayload) {
    return null;
  }
  templateStorage.setItem(STORAGE_KEYS.lastAliasPayload, serializedPayload);
  return payload;
}

function getUserDataSource() {
  if (data.userDataSource === 'dataLayer') {
    const userData = copyFromDataLayer('user_data', 1);
    return getType(userData) === 'object' ? userData : null;
  }
  if (data.userDataSource === 'variable') {
    return getType(data.userDataVariable) === 'object' ? data.userDataVariable : null;
  }
  if (data.userDataSource === 'manual') {
    return {
      email: data.userEmail,
      phone_number: data.userPhoneNumber,
      id: data.userId,
      partner_user_id: data.partnerUserId
    };
  }
  return null;
}

// The SDK normalizes and SHA-256 hashes email and phone_number itself and has
// no way to accept an already-hashed value, so hashed input would be hashed
// twice and never match.
function addUserValue(payload, key, value) {
  if (getType(value) === 'array') value = value[0];
  if (!hasValue(value)) return;
  const text = trim(makeString(value));
  if (isSha256Hex(text)) {
    log('Dropped a pre-hashed ' + key + '. The Spotify Pixel hashes ' + key + ' itself, so send the raw value.');
    return;
  }
  payload[key] = text;
}

/*==============================================================================
  Helpers
==============================================================================*/

function log(message) {
  if (isDebug) {
    logToConsole(LOG_PREFIX + message);
  }
}

function fail(message) {
  logToConsole(LOG_PREFIX + message);
  data.gtmOnFailure();
}

function hasValue(value) {
  return value !== undefined && value !== null && value !== '';
}

function firstValue(values) {
  for (let index = 0; index < values.length; index++) {
    if (hasValue(values[index])) return values[index];
  }
  return undefined;
}

function assign(target, source) {
  Object.keys(source).forEach((key) => {
    if (hasValue(source[key])) {
      target[key] = source[key];
    }
  });
  return target;
}

function trim(value) {
  return makeString(value).trim();
}

function isHex(text) {
  const hexCharacters = '0123456789abcdefABCDEF';
  for (let index = 0; index < text.length; index++) {
    if (hexCharacters.indexOf(text.charAt(index)) === -1) return false;
  }
  return true;
}

function isPixelId(text) {
  return text.length === 32 && isHex(text);
}

function isSha256Hex(text) {
  return text.length === 64 && isHex(text);
}


